{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Cheap-Coin/cheap-protocol/main/deployments/deployment-manifest-v1.schema.json",
  "title": "CheapCoin Robinhood Chain deployment manifest v1",
  "description": "Public, machine-readable identity and configuration for one CheapCoin production deployment. Cross-field address, supply, and release-tag invariants are additionally enforced by @cheap/protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentId",
    "status",
    "network",
    "publication",
    "cheapToken",
    "primaryMarket",
    "governance",
    "contracts",
    "vesting"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deploymentId": { "$ref": "#/$defs/deploymentId" },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "active" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason", "supersededBy"],
          "properties": {
            "state": { "const": "superseded" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
            "supersededBy": { "$ref": "#/$defs/deploymentId" }
          }
        }
      ]
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "name", "finalityBlock", "finalityBlockHash"],
      "properties": {
        "chainId": { "const": 4663 },
        "name": { "const": "Robinhood Chain" },
        "finalityBlock": { "$ref": "#/$defs/positiveDecimal" },
        "finalityBlockHash": { "$ref": "#/$defs/hash32" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishedAt",
        "releaseSequence",
        "sourceRepository",
        "sourceCommit",
        "signedTag",
        "manifestPath"
      ],
      "properties": {
        "publishedAt": { "$ref": "#/$defs/timestamp" },
        "releaseSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "sourceRepository": {
          "const": "https://github.com/Cheap-Coin/cheap-protocol"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "signedTag": {
          "type": "string",
          "pattern": "^deployment/[a-z0-9]+(?:-[a-z0-9]+)*/v[1-9][0-9]*$",
          "maxLength": 100
        },
        "manifestPath": {
          "type": "string",
          "pattern": "^deployments/[a-z0-9]+(?:-[a-z0-9]+)*\\.manifest\\.json$",
          "maxLength": 128
        }
      }
    },
    "cheapToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "symbol", "decimals", "totalSupply", "contract"],
      "properties": {
        "name": { "const": "CheapCoin" },
        "symbol": { "const": "CHEAP" },
        "decimals": { "$ref": "#/$defs/decimals" },
        "totalSupply": { "$ref": "#/$defs/positiveDecimal" },
        "contract": { "$ref": "#/$defs/verifiedContract" }
      }
    },
    "primaryMarket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quoteAsset", "pool", "feeManager", "feeBeneficiary"],
      "properties": {
        "quoteAsset": { "$ref": "#/$defs/rewardAsset" },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "poolId",
            "initializationTransactionHash",
            "initializationBlock",
            "initializationBlockHash",
            "tokenIsToken0",
            "quoteOnlyCreatorFees",
            "swapFeePips",
            "creatorFeePips"
          ],
          "properties": {
            "poolId": { "$ref": "#/$defs/hash32" },
            "initializationTransactionHash": { "$ref": "#/$defs/hash32" },
            "initializationBlock": { "$ref": "#/$defs/positiveDecimal" },
            "initializationBlockHash": { "$ref": "#/$defs/hash32" },
            "tokenIsToken0": { "type": "boolean" },
            "quoteOnlyCreatorFees": { "const": true },
            "swapFeePips": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "creatorFeePips": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "feeManager": { "$ref": "#/$defs/codeReference" },
        "feeBeneficiary": { "$ref": "#/$defs/address" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolOwnerSafe",
        "creatorRecipient",
        "holderTreasurySafe",
        "distributionOperator"
      ],
      "properties": {
        "protocolOwnerSafe": { "$ref": "#/$defs/address" },
        "creatorRecipient": { "$ref": "#/$defs/address" },
        "holderTreasurySafe": { "$ref": "#/$defs/address" },
        "distributionOperator": { "$ref": "#/$defs/address" }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feeSplitter",
        "feeSplitterConstructorArguments",
        "rewardDistributors"
      ],
      "properties": {
        "feeSplitter": { "$ref": "#/$defs/protocolContract" },
        "feeSplitterConstructorArguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rewardToken",
            "creatorRecipient",
            "holderTreasury",
            "initialOwner"
          ],
          "properties": {
            "rewardToken": { "$ref": "#/$defs/address" },
            "creatorRecipient": { "$ref": "#/$defs/address" },
            "holderTreasury": { "$ref": "#/$defs/address" },
            "initialOwner": { "$ref": "#/$defs/address" }
          }
        },
        "rewardDistributors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/rewardDistributor" }
        }
      }
    },
    "vesting": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "allocationBps",
            "allocation",
            "beneficiary",
            "startsAt",
            "cliffEndsAt",
            "fullyVestedAt",
            "vault"
          ],
          "properties": {
            "mode": { "const": "linear" },
            "allocationBps": { "const": 1500 },
            "allocation": { "$ref": "#/$defs/positiveDecimal" },
            "beneficiary": { "$ref": "#/$defs/address" },
            "startsAt": { "$ref": "#/$defs/timestamp" },
            "cliffEndsAt": { "$ref": "#/$defs/timestamp" },
            "fullyVestedAt": { "$ref": "#/$defs/timestamp" },
            "vault": { "$ref": "#/$defs/verifiedContract" }
          }
        }
      ]
    }
  },
  "$defs": {
    "deploymentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "address": {
      "type": "string",
      "pattern": "^0x(?!0{40}$)[0-9a-fA-F]{40}$"
    },
    "hash32": {
      "type": "string",
      "pattern": "^0x(?!0{64}$)[0-9a-f]{64}$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 128
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "codeReferenceBase": {
      "type": "object",
      "required": ["address", "runtimeCodeHash", "sourceVerificationUrl", "proxy"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "runtimeCodeHash": { "$ref": "#/$defs/hash32" },
        "sourceVerificationUrl": { "$ref": "#/$defs/httpsUrl" },
        "proxy": { "$ref": "#/$defs/proxy" }
      }
    },
    "codeReference": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/codeReferenceBase" }],
      "unevaluatedProperties": false
    },
    "verifiedContract": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/codeReferenceBase" },
        {
          "type": "object",
          "required": [
            "deploymentTransactionHash",
            "deploymentBlock",
            "deploymentBlockHash"
          ],
          "properties": {
            "deploymentTransactionHash": { "$ref": "#/$defs/hash32" },
            "deploymentBlock": { "$ref": "#/$defs/positiveDecimal" },
            "deploymentBlockHash": { "$ref": "#/$defs/hash32" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solcVersion",
        "optimizer",
        "optimizerRuns",
        "evmVersion",
        "viaIr",
        "metadataBytecodeHash"
      ],
      "properties": {
        "solcVersion": {
          "type": "string",
          "pattern": "^0\\.8\\.28(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "optimizer": { "const": true },
        "optimizerRuns": { "const": 10000 },
        "evmVersion": { "const": "cancun" },
        "viaIr": { "const": false },
        "metadataBytecodeHash": { "const": "none" }
      }
    },
    "protocolContract": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/codeReferenceBase" },
        {
          "type": "object",
          "required": [
            "deploymentTransactionHash",
            "deploymentBlock",
            "deploymentBlockHash",
            "compiler"
          ],
          "properties": {
            "deploymentTransactionHash": { "$ref": "#/$defs/hash32" },
            "deploymentBlock": { "$ref": "#/$defs/positiveDecimal" },
            "deploymentBlockHash": { "$ref": "#/$defs/hash32" },
            "compiler": { "$ref": "#/$defs/compiler" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rewardAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol",
        "decimals",
        "address",
        "runtimeCodeHash",
        "sourceVerificationUrl",
        "proxy",
        "registryUrl",
        "registryVerifiedAtBlock"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,11}$"
        },
        "decimals": { "$ref": "#/$defs/decimals" },
        "address": { "$ref": "#/$defs/address" },
        "runtimeCodeHash": { "$ref": "#/$defs/hash32" },
        "sourceVerificationUrl": { "$ref": "#/$defs/httpsUrl" },
        "proxy": { "$ref": "#/$defs/proxy" },
        "registryUrl": { "$ref": "#/$defs/httpsUrl" },
        "registryVerifiedAtBlock": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "proxy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "implementation"],
          "properties": {
            "kind": { "enum": ["eip1967", "eip1167"] },
            "implementation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["address", "runtimeCodeHash", "sourceVerificationUrl"],
              "properties": {
                "address": { "$ref": "#/$defs/address" },
                "runtimeCodeHash": { "$ref": "#/$defs/hash32" },
                "sourceVerificationUrl": { "$ref": "#/$defs/httpsUrl" }
              }
            }
          }
        }
      ]
    },
    "rewardDistributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rewardAsset", "contract", "constructorArguments"],
      "properties": {
        "rewardAsset": { "$ref": "#/$defs/rewardAsset" },
        "contract": { "$ref": "#/$defs/protocolContract" },
        "constructorArguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rewardToken", "operator", "initialOwner"],
          "properties": {
            "rewardToken": { "$ref": "#/$defs/address" },
            "operator": { "$ref": "#/$defs/address" },
            "initialOwner": { "$ref": "#/$defs/address" }
          }
        }
      }
    }
  }
}
